# Сборка PyInstaller — 75 МБ мусора, воспроизводится через build_exe.bat
build/
dist/

# Кэш Python
__pycache__/
*.py[cod]

# Песок стенда: devserver.py подменяет USERPROFILE, там лежит фейковый профиль
.devsandbox/

# Данные приложения и логи
*.db
*.db-wal
*.db-shm
*.log

# Локальное окружение и секреты (никогда не коммитить)
.env
.venv/
venv/

# Редакторы и мусор Windows
.vscode/
.idea/
Thumbs.db
desktop.ini